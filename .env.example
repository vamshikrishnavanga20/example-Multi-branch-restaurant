# =============================================================================
# S4 MANOHAA FOOD PLAZA — PRODUCTION ENVIRONMENT VARIABLES (VERCEL DEPLOYMENT)
# =============================================================================
# Add these variables to your Vercel Project Settings:
# Settings -> Environment Variables -> Production & Preview
# =============================================================================

# --- AWS Core (Required for DynamoDB & S3) ---
# Region where your DynamoDB table and S3 buckets are hosted (e.g. ap-south-1 or ap-south-2)
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- DynamoDB Single-Table Store (Required) ---
# Name of the DynamoDB single-table design table
DYNAMODB_TABLE_NAME=ManohaaHotel

# --- S3 Assets & Automated Backups (Required for file uploads & backup engine) ---
AWS_S3_BUCKET_NAME=manohaa-hotel-assets
BACKUP_S3_BUCKET_NAME=manohaa-hotel-backups
BACKUP_CRON_SCHEDULE="0 2 * * 1"
# Optional CloudFront CDN distribution domain for assets (e.g. d1234abcd.cloudfront.net)
CLOUDFRONT_DOMAIN=

# --- JWT & Super Admin Authentication (Required) ---
# High-entropy secret used to sign session JWT tokens (minimum 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
ADMIN_EMAIL=admin@s4manohaa.com
ADMIN_PASSWORD=your_strong_admin_password

# --- AI Intelligence & Deep Analytics (Required for AI Engine & Reports) ---
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
# Optional Groq API Key for fast Llama-3 inference in deep analysis
GROQ_API_KEY=your_groq_api_key

# --- Meta WhatsApp Cloud API (Optional - for KOT Chef dispatch & EOD reports) ---
WA_PHONE_NUMBER_ID=your_meta_wa_phone_number_id
WA_ACCESS_TOKEN=your_meta_wa_access_token
CHEF_WHATSAPP_NUMBER=919876543210
OWNER_WHATSAPP_NUMBER=919876543210

# --- Vercel Cron Secret (Required for automated Cron routes) ---
# Must match the Authorization: Bearer <CRON_SECRET> sent by Vercel Cron
CRON_SECRET=your_cron_secret_token
